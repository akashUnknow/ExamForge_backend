# ---- Database ----
DATABASE_NAME=examforge
DATABASE_URL=jdbc:postgresql://localhost:5432/examforge
DATABASE_USERNAME=examforge
DATABASE_PASSWORD=change_me

# ---- JWT (used starting Phase 2, defined now for forward compatibility) ----
JWT_SECRET=change_me_to_a_long_random_string_at_least_256_bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---- Attempt sweep (Phase 6/7) ----
ATTEMPT_SWEEP_INTERVAL_MS=60000

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Payments (used starting Phase 11) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Mail ----
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Object storage (S3-compatible, prepared for a future implementation - unused until then) ----
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ---- Local file storage (Phase 8 - actually used by LocalFileStorageService) ----
STORAGE_LOCAL_PATH=./storage

# ---- App ----
SPRING_PROFILES_ACTIVE=dev
